---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% assign base_url = site.url | default: "https://thestepupapp.com" %}
{% for item in site.data.home.languages %}{% assign lt = item[1] %}
	<url>
		<loc>{{ base_url }}{{ lt.path }}</loc>
		{% for alt in site.data.home.languages %}{% assign alt_lang = alt[0] %}{% assign alt_t = alt[1] %}<xhtml:link rel="alternate" hreflang="{{ alt_lang }}" href="{{ base_url }}{{ alt_t.path }}" />{% endfor %}
		<xhtml:link rel="alternate" hreflang="x-default" href="{{ base_url }}/" />
		<lastmod>2026-06-12</lastmod>
		<changefreq>weekly</changefreq>
		<priority>{% if lt.path == "/" %}1.0{% else %}0.8{% endif %}</priority>
	</url>
{% endfor %}
	<url><loc>{{ base_url }}/privacy/</loc><lastmod>2026-06-11</lastmod><changefreq>yearly</changefreq><priority>0.3</priority></url>
	<url><loc>{{ base_url }}/terms/</loc><lastmod>2026-06-11</lastmod><changefreq>yearly</changefreq><priority>0.3</priority></url>
</urlset>
